#!/bin/sh
# Пакет claude-status
# Устанавливает:
#   ~/.config/claude-status/claude_usage.py
#   ~/.local/share/gnome-shell/extensions/claude-status@panel.local/

set -e

# Каталог пакета
PKG_DIR=/opt/claude-status

# Пользовательские каталоги
USER_CONFIG="$HOME/.config/claude-status"
USER_EXTENSIONS="$HOME/.local/share/gnome-shell/extensions"
EXT_NAME="claude-status@panel.local"

install() {
    echo "Установка claude-status..."

    # Создаём каталоги
    mkdir -p "$USER_CONFIG"
    mkdir -p "$USER_EXTENSIONS/$EXT_NAME"

    # Копируем файлы
    cp /usr/share/claude-status/claude_usage.py "$USER_CONFIG/"
    cp /usr/share/claude-status/gnome-extension/* "$USER_EXTENSIONS/$EXT_NAME/"

    # Права
    chmod +x "$USER_CONFIG/claude_usage.py"

    echo "Установлено:"
    echo "  - $USER_CONFIG/claude_usage.py"
    echo "  - $USER_EXTENSIONS/$EXT_NAME/"
    echo ""
    echo "Активируйте расширение:"
    echo "  gnome-extensions enable $EXT_NAME"
    echo "Перезапустите GNOME Shell (Wayland: перелогин, X11: Alt+F2 -> r)."
}

remove() {
    echo "Удаление claude-status..."

    # Отключаем расширение
    gnome-extensions disable $EXT_NAME 2>/dev/null || true

    # Удаляем файлы
    rm -rf "$USER_CONFIG/claude-status"
    rm -rf "$USER_EXTENSIONS/$EXT_NAME"

    # Удаляем системные файлы
    rm -rf /usr/share/claude-status
    rm -rf /opt/claude-status

    echo "Удалено."
}

case "$1" in
    install)
        install
        ;;
    remove)
        remove
        ;;
    *)
        echo "Использование: $0 {install|remove}" >&2
        exit 1
        ;;
esac
